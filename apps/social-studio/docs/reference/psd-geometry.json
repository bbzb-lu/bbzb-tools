      "elements": [
        { "role": "foto", "x": 0, "y": 0, "w": 2160, "h": 1350, "fit": "cover", "spansSeam": true },
        { "role": "kommentar", "x": 72, "y": 656, "w": 500, "h": 139, "size": 66, "leading": 76, "color": "warmweiss", "align": "left", "sample": "Wahlangebote fürs\n3. und 4. Lehrjahr." },
        { "role": "kommentar", "x": 1727, "y": 96, "w": 361, "h": 126, "size": 66, "leading": 76, "color": "blauschwarz", "align": "right", "anchor": "rechter Rand bei 2088", "sample": "Golf, Kajak\nund Flowtrail." },
        { "role": "scribble", "asset": "pfeil-quer", "x": 870, "y": 612, "w": 420, "h": 191, "anchor": "horizontal mittig auf der Naht (x = 1080)" }
      ]
    },
    "collage": {
