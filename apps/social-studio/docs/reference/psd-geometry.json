{
  "_info": {
    "source": "Template Post/Vorlage-Post-Insta-LinkedIn.psd, ausgelesen am 21.10.2026 per Photoshop-Skript",
    "units": "px, Slide 1080 x 1350, Koordinaten relativ zur Slide (x, y = linke obere Ecke der Ebenen-Bounds ohne Effekte)",
    "fontSizes": "px bei 72 dpi. tracking in 1/1000 em (Photoshop-Laufweite). leading = Zeilenabstand in px",
    "caveats": [
      "Text-Bounds sind die Tinten-Box, nicht die Textbox. Für die Positionierung zählt die Grundlinie, Werte mit den Referenz-JPGs abgleichen.",
      "Fotos und Platzhalter sind Instagram-Screenshots, ihre Bounds zeigen nur die damalige Platzierung (cover).",
      "Zwei Kommentarfarben in der PSD weichen von der Palette ab (#132348 auf 02, #F5F5E3 auf 03). In der App auf blauschwarz bzw. warmweiss normalisieren."
    ]
  },
  "tokens": {
    "margin": 72,
    "colors": { "blau": "#009FE2", "orange": "#FF4E00", "warmweiss": "#FBF8F3", "blauschwarz": "#0F1B26" }
  },
  "textStyles": {
    "titel": { "font": "SegoeUIBlack", "file": "brand/fonts/seguibl.ttf", "tracking": -40, "examples": [{ "size": 222, "leading": 190 }, { "size": 150, "leading": 146 }] },
    "kommentar": { "font": "Braveold-Light", "file": "brand/fonts/Braveold-Light.otf", "tracking": -10, "ligatures": false, "examples": [{ "size": 66, "leading": 76 }, { "size": 62, "leading": 72 }, { "size": 54, "leading": 64 }] },
    "tag": { "font": "SegoeUI-Bold", "file": "brand/fonts/segoeuib.ttf", "uppercase": true, "size": 28, "tracking": 110 },
    "cta": { "font": "SegoeUI-Bold", "file": "brand/fonts/segoeuib.ttf", "uppercase": true, "size": 34, "tracking": 110 }
  },
  "components": {
    "schulTag": { "height": 62, "fill": "orange", "text": "tag", "textColor": "warmweiss", "paddingLeft": 36, "paddingRight": 36, "example": "BBZB BAHNHOF, Breite 323" },
    "ortTag": { "height": 62, "fill": "blauschwarz", "icon": { "src": "brand/icons/map-pin.svg", "x": 22, "y": 11, "w": 33, "h": 41 }, "textX": 68, "paddingRight": 36, "text": "tag", "textColor": "warmweiss" },
    "cta": { "height": 75, "fill": "orange", "text": "cta", "textColor": "warmweiss", "paddingLeft": 44, "paddingRight": 44, "instagram": "LINK IN BIO", "linkedin": "BBZB.LU.CH" },
    "sticker": {
      "outline": { "style": "outside", "size": 12, "color": "warmweiss" },
      "dropShadow": { "blend": "multiply", "color": "#002846", "opacity": 0.25, "angle": 90, "distance": 10, "blur": 22 }
    },
    "fotoRahmen": { "fill": "warmweiss", "dropShadow": { "blend": "multiply", "color": "#002846", "opacity": 0.22, "angle": 90, "distance": 14, "blur": 30 } },
    "scribble": { "colorOverlay": "orange", "note": "Quell-PNGs sind dunkelblau, werden vollflächig eingefärbt" },
    "filmkorn": { "texture": "brand/textures/film-grain-03.jpg", "blend": "overlay", "opacityFoto": 0.14, "opacityFlaeche": 0.40, "scope": "nur auf das darunterliegende Foto bzw. die blaue Fläche geschnitten, nie global" },
    "bildlook": {
      "photoFilter": { "colorLab": [67.19, 33.14, 72.79], "approxHex": "#EC8A00", "density": 0.12, "preserveLuminosity": true },
      "vibrance": 5,
      "saturation": -5,
      "note": "Annäherung an die Lightroom-Presets des Teams, auf Platzhaltern verwendet"
    },
    "verlaufOben": { "color": "blauschwarz", "direction": "von oben nach unten", "stops": [{ "at": 0, "alpha": 0.45 }, { "at": 0.56, "alpha": 0 }], "layerOpacity": 0.25 },
    "verlaufUnten": { "color": "#0B2A3C", "direction": "von unten nach oben", "stops": [{ "at": 0, "alpha": 0.70 }, { "at": 0.56, "alpha": 0 }], "layerOpacity": 1.0 }
  },
  "layouts": {
    "titel": {
      "slides": 1,
      "background": "foto vollflächig (cover) + filmkorn foto",
      "elements": [
        { "role": "foto", "x": 0, "y": 0, "w": 1080, "h": 1350, "fit": "cover" },
        { "role": "verlauf", "ref": "verlaufOben", "optional": true },
        { "role": "titel", "x": 62, "y": 190, "w": 851, "h": 591, "size": 222, "leading": 190, "color": "warmweiss", "align": "left", "sample": "Sommer\nsport\ntage" },
        { "role": "motivVorTitel", "note": "Freisteller-Kopie des Fotos, deckungsgleich, über dem Titel" },
        { "role": "kommentar", "x": 72, "y": 1075, "w": 511, "h": 132, "size": 62, "leading": 72, "color": "warmweiss", "sample": "Seilpark, Flowtrail\nund Schwyzerörgeli." },
        { "role": "schulTag", "x": 685, "y": 72, "anchor": "rechts oben, rechter Rand bei 1008", "sample": "BBZB BAHNHOF" }
      ]
    },
    "vollbild": {
