lt;br&gt;pushen, PR öffnen, «Closes #Nr» in den Text" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1208" y="540" width="250" height="100" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;f Vorschau + Merge&lt;/b&gt;&lt;br&gt;Link im PR testen, nach OK mergen" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="540" width="250" height="100" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value='&lt;b&gt;Im Terminal&lt;/b&gt;&lt;br&gt;git switch main&lt;br&gt;git pull&lt;br&gt;git switch -c kurzes-thema&lt;br&gt;npm run check&lt;br&gt;git commit -am "Fix button text"&lt;br&gt;git push -u origin kurzes-thema' style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="560" height="170" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Ohne Terminal&lt;/b&gt;&lt;br&gt;• &lt;b&gt;GitHub Desktop&lt;/b&gt;: «Current branch → New branch», «Commit», «Push origin», «Create Pull Request»&lt;br&gt;• im Issue rechts «Create a branch»&lt;br&gt;• &lt;b&gt;Claude Code&lt;/b&gt;: siehe Blatt «Entwicklung mit KI»" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="680" width="560" height="170" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Regeln&lt;/b&gt;&lt;br&gt;• nie direkt auf main arbeiten&lt;br&gt;• vor jedem PR &lt;i&gt;npm run check&lt;/i&gt;&lt;br&gt;• Merge erst nach grüner CI und OK&lt;br&gt;• keine echten Fotos, Namen oder Dateien in Issues&lt;br&gt;• Texte: Deutsch, Schweizer Schreibweise, Du-Form&lt;br&gt;• Commit-Nachrichten kurz, auf Englisch" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="680" width="560" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 Änderung machen"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;So kommt eine Änderung live&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Klein und schnell oder gross mit allen Prüfungen. In beiden Fällen nie direkt auf main." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Wo:&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="124" width="120" height="24" as="geometry"/></mxCell><mxCell id="c5" value="dein Rechner" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c6" value="GitHub" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c7" v