3a6;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="430" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;4 Branch&lt;/b&gt;&lt;br&gt;von main" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="625" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;5 Umsetzen&lt;/b&gt;&lt;br&gt;Schritt für Schritt mit Review" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;6 npm run check&lt;/b&gt;&lt;br&gt;plus von Hand in Edge" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1015" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;7 PR + Label «e2e»&lt;/b&gt;&lt;br&gt;startet die Windows-Tests" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;8 CI: test + e2e&lt;/b&gt;&lt;br&gt;länger, dann Vorschau" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1405" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;9 Merge + Live&lt;/b&gt;&lt;br&gt;nach Test und OK" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1600" y="400" width="160" height="90" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;C&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="34" height="34" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Was die CI automatisch macht (GitHub Actions)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="543" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c50" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="582" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Bei jedem Push im PR&lt;/b&gt;&lt;br&gt;&lt;b&gt;test&lt;/b&gt;: Typen, Lint, Unit-Tests, Build wie live&lt;br&gt;danach &lt;b&gt;Vorschau&lt;/b&gt; unter &amp;lt;branch&amp;gt;.bbzb-tools.pages.dev, Link im PR" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="610" width="560.0" height="110" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Nur mit Label «e2e»&lt;/b&gt;&lt;br&gt;&lt;b&gt;e2e&lt;/b&gt;: Playwright in Edge auf Windows, nur für die betroffenen Tools&lt;br&gt;muss vor dem Merge grün sein" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="610" width="560.0" height="110" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Nach dem Merge auf main&lt;/b&gt;&lt;br&gt;&lt;b&gt;test&lt;/b&gt;, dann &lt;b&gt;deploy&lt;/b&gt; zu Cloudflare&lt;br&gt;die Live-Seite ist nach wenigen Minuten aktuell" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200.0" y="610" width="560.0" height="110" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;CI ist rot?&lt;/b&gt;&lt;br&gt;• im PR beim roten Job auf «Details»: Log lesen&lt;br&gt;• lokal fixen, committen, pushen: die CI startet neu&lt;br&gt;• Tests nie abschwächen oder überspringen" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="760" width="850.0" height="130" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Feste Regeln&lt;/b&gt;&lt;br&gt;• main läuft immer&lt;br&gt;• Deploy nur über die CI, nie von Hand&lt;br&gt;• Merge erst nach grüner CI und OK&lt;br&gt;• nach dem Live-Gang kurz prüfen, Issue schliessen" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910.0" y="760" width="850.0" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 Entwicklung mit KI"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Entwicklung mit KI: Claude Code&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Claude Code arbeitet im Terminal direkt im Repo: liest Code und Regeln, schreibt Code, führt Tests aus. Du entscheidest und gibst frei." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="34" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Einmal einrichten&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="123" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Programme&lt;/b&gt;&lt;br&gt;Git, Node.js (Version steht in .nvmrc), VS Code, Edge" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;installieren nach Anleitung auf claude.com/claude-code, anmelden" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="332" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Repo holen&lt;/b&gt;&lt;br&gt;git clone, dann in den Ordner wechseln" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="624" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Abhängigkeiten&lt;/b&gt;&lt;br&gt;npm install, optional npm run fonts" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="916" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Claude starten&lt;/b&gt;&lt;br&gt;im Repo-Ordner: claude" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1208" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Plugins&lt;/b&gt;&lt;br&gt;beim ersten Start Ordner vertrauen, vorgeschlagene Plugins installieren" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Im Terminal&lt;/b&gt;&lt;br&gt;cd Documents\GitHub&lt;br&gt;git clone https://github.com/bbzb-lu/bbzb-tools&lt;br&gt;cd bbzb-tools&lt;br&gt;npm install&lt;br&gt;claude" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="560" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Plugins&lt;/b&gt; (im Repo eingetragen, verwalten mit /plugin)&lt;br&gt;• &lt;b&gt;Superpowers&lt;/b&gt;: fester Ablauf: klären, planen, testen, prüfen&lt;br&gt;• &lt;b&gt;Ponytail&lt;/b&gt;: knapper Code, nichts Unnötiges&lt;br&gt;• &lt;b&gt;Impeccable&lt;/b&gt;: gute Oberflächen" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="560" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;AGENTS.md&lt;/b&gt;&lt;br&gt;Regeln für das ganze Repo und pro Tool. Claude liest sie automatisch. Gilt etwas immer, gehört es dort hinein, statt es jedes Mal zu sagen." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200" y="320" width="560" height="150" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="34" height="34" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Ein neues Feature oder Tool entwerfen&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="513" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;1 Auftrag&lt;/b&gt;&lt;br&gt;Issue nennen, Ziel in eigenen Worten" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;2 Klären&lt;/b&gt;&lt;br&gt;Claude fragt nach (Brainstorming), du entscheidest" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="290" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;3 Spezifikation&lt;/b&gt;&lt;br&gt;Claude schreibt auf, was gebaut wird" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;4 Plan&lt;/b&gt;&lt;br&gt;Schritte mit Tests, du gibst frei" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="790" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;5 Umsetzung&lt;/b&gt;&lt;br&gt;Schritt für Schritt, jeder Schritt wird geprüft" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;6 Selbst prüfen&lt;/b&gt;&lt;br&gt;npm run check, in Edge ausprobieren" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;7 PR&lt;/b&gt;&lt;br&gt;Vorschau testen, Merge nach OK" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1540" y="580" width="220" height="100" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="&lt;b&gt;Beispiel-Auftrag&lt;/b&gt;&lt;br&gt;«Neues Tool für Raumreservationen, siehe Issue #42. Bitte zuerst brainstormen.»&lt;br&gt;Ein neues Tool legt Claude mit &lt;i&gt;npm run neues-tool&lt;/i&gt; aus der Vorlage an." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="720" width="560.0" height="130" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Tipps&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Esc&lt;/b&gt; unterbricht Claude&lt;br&gt;• &lt;b&gt;/clear&lt;/b&gt; startet eine neue Aufgabe&lt;br&gt;• Screenshots ins Terminal ziehen&lt;br&gt;• Freigaben lesen, bevor du sie bestätigst" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="720" width="560.0" height="130" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Verantwortung&lt;/b&gt;&lt;br&gt;• du bist für das Ergebnis verantwortlich&lt;br&gt;• keine Personendaten, Passwörter oder Schlüssel in den Chat&lt;br&gt;• Ergebnis selbst in Edge prüfen" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200.0" y="720" width="560.0" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="6 Hosting und Daten"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Wo der Code liegt, wo er läuft, wo Daten bleiben&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Kein eigener Server, keine Datenbank. Cloudflare liefert fertige Dateien aus, gerechnet wird im Browser." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 Quellcode: GitHub&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=20;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="340" height="44" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2 Bauen: GitHub Actions&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=20;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="340" height="44" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3 Hosting: Cloudflare Pages&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=20;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="340" height="44" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4 Nutzung: Browser&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=20;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1420" y="120" width="340" height="44" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;bbzb-lu/bbzb-tools&lt;/b&gt; (öffentlich)&lt;br&gt;Code, Issues, Board, Pull Requests" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="340" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Privates Repo&lt;/b&gt;&lt;br&gt;lizenzierte Inhalte (z. B. Schriften), nie im öffentlichen Repo" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="340" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Secrets&lt;/b&gt;&lt;br&gt;Zugangsschlüssel für Cloudflare und das private Repo" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="340" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Bei jedem Push&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Code und lizenzierte Inhalte holen&lt;br&gt;2. testen&lt;br&gt;3. Vite Build → Ordner dist/&lt;br&gt;4. wrangler lädt dist/ zu Cloudflare&lt;br&gt;&lt;br&gt;Secrets gibt es nur während dieses Ablaufs." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="340" height="390" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Live&lt;/b&gt;&lt;br&gt;bbzb-tools.pages.dev, Stand von main" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="340" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Vorschau&lt;/b&gt;&lt;br&gt;&amp;lt;branch&amp;gt;.bbzb-tools.pages.dev, Stand eines PR" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="340" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;_headers&lt;/b&gt;&lt;br&gt;Sicherheitsregeln: mit welchen Adressen der Browser reden darf" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="340" height="110" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Edge auf Windows 11&lt;/b&gt;&lt;br&gt;alle Tools über die Startseite&lt;br&gt;&lt;br&gt;&lt;b&gt;SharePoint&lt;/b&gt;&lt;br&gt;bettet die Embeds ein&lt;br&gt;&lt;br&gt;&lt;b&gt;Daten bleiben im Browser&lt;/b&gt;&lt;br&gt;localStorage, IndexedDB, OPFS, jeweils mit der Tool-ID im Namen. Dateien werden nie hochgeladen." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1420" y="200" width="340" height="390" as="geometry"/></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.14;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.86;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.14;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.14;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Was es NICHT gibt&lt;/b&gt;&lt;br&gt;• kein Backend, keine Datenbank, keine Logins&lt;br&gt;• kein Upload, keine Analytics, keine fremden Skripte&lt;br&gt;• Cloudflare sieht nur Seitenaufrufe, keine Inhalte" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="640" width="850.0" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Ausnahmen&lt;/b&gt;&lt;br&gt;Braucht ein Tool etwas von aussen (z. B. KI-Modelle oder einen Stream), wird genau diese Adresse in &lt;i&gt;_headers&lt;/i&gt; nur für dieses Tool freigegeben, und nur zum Herunterladen." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910.0" y="640" width="850.0" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>