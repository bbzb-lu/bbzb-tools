<mxfile host="drawio"><diagram id="p0" name="1 Überblick und Technik"><mxGraphModel dx="1800" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;BBZB Tools im Überblick&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Kleine Web-Tools für den Schulalltag. Alles läuft im Browser, nichts wird hochgeladen, kein eigener Server." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="34" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Vom Code zur fertigen Seite&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="123" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Quellcode&lt;/b&gt;&lt;br&gt;TypeScript und React, ein Ordner pro Tool" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="304" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;npm install&lt;/b&gt;&lt;br&gt;lädt alle Bibliotheken nach node_modules/" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="394" y="190" width="304" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Vite Build&lt;/b&gt;&lt;br&gt;übersetzt und bündelt alles für den Browser" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="748" y="190" width="304" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;dist/&lt;/b&gt;&lt;br&gt;fertige Dateien: HTML, JavaScript, CSS, Bilder, Schriften" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="190" width="304" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Cloudflare → Browser&lt;/b&gt;&lt;br&gt;Cloudflare liefert aus, der Browser führt aus" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1456" y="190" width="304" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;2&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="34" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Die Werkzeuge kurz erklärt&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="343" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Node.js&lt;/b&gt;&lt;br&gt;führt JavaScript auf deinem Rechner aus. Nur zum Entwickeln und Bauen nötig, nicht im Browser." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="410" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;npm&lt;/b&gt;&lt;br&gt;Paketverwaltung von Node.js: lädt Bibliotheken (Pakete) und startet Befehle wie &lt;i&gt;npm run build&lt;/i&gt;. Was gebraucht wird, steht in &lt;i&gt;package.json&lt;/i&gt;." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="475.0" y="410" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;TypeScript&lt;/b&gt;&lt;br&gt;JavaScript mit Typen. Viele Fehler fallen schon beim Schreiben auf (&lt;i&gt;npm run typecheck&lt;/i&gt;)." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910.0" y="410" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;React&lt;/b&gt;&lt;br&gt;Bibliothek für Oberflächen. Jede Ansicht ist eine Komponente, die sich bei neuen Daten selbst neu zeichnet." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1345.0" y="410" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Vite&lt;/b&gt;&lt;br&gt;Beim Entwickeln: lokaler Server mit sofortiger Vorschau (&lt;i&gt;npm run dev:…&lt;/i&gt;). Beim Build: bündelt und verkleinert den Code zu wenigen Dateien in &lt;i&gt;dist/&lt;/i&gt;." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="540" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Vitest&lt;/b&gt;&lt;br&gt;Unit-Tests: prüft einzelne Funktionen in Sekunden (&lt;i&gt;npm test&lt;/i&gt;)." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="475.0" y="540" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Playwright&lt;/b&gt;&lt;br&gt;End-to-End-Tests: öffnet Edge und klickt die Tools durch wie ein Mensch." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="910.0" y="540" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;ESLint&lt;/b&gt;&lt;br&gt;prüft Code-Stil und typische Fehler (&lt;i&gt;npm run lint&lt;/i&gt;)." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1345.0" y="540" width="415.0" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;3&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="34" height="34" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Was wo liegt&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="693" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c29" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="732" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;apps/&amp;lt;id&amp;gt;/&lt;/b&gt;&lt;br&gt;ein Ordner pro Tool, mit eigener AGENTS.md und eigenen Bibliotheken in package.json" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="760" width="560.0" height="85" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;apps/startseite/&lt;/b&gt;&lt;br&gt;Übersicht aller Tools, liegt im Build ganz oben" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="760" width="560.0" height="85" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;packages/ui/&lt;/b&gt;&lt;br&gt;gemeinsames Aussehen: Farben, Masse, Bauteile" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200.0" y="760" width="560.0" height="85" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;embeds/&amp;lt;id&amp;gt;/&lt;/b&gt;&lt;br&gt;kleine Einbettungen für SharePoint, ohne Build kopiert" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="865" width="560.0" height="85" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;scripts/ und .github/&lt;/b&gt;&lt;br&gt;Befehle für Build, Prüfungen und die CI" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="620.0" y="865" width="560.0" height="85" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;docs/&lt;/b&gt;&lt;br&gt;Abläufe, Spezifikationen, Pläne, diese Diagramme" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1200.0" y="865" width="560.0" height="85" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 Git-Grundlagen"><mxGraphModel dx="1800" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Git in fünf Minuten&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Git merkt sich jede Version des Codes. GitHub ist der gemeinsame Speicher: alle holen von dort und laden dorthin hoch." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="34" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Die vier Orte, durch die eine Änderung wandert&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="123" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Arbeitsordner&lt;/b&gt;&lt;br&gt;deine Dateien, hier bearbeitest du" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Staging&lt;/b&gt;&lt;br&gt;vorgemerkt für den nächsten Commit" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Lokales Repo&lt;/b&gt;&lt;br&gt;deine Commits, noch nur bei dir" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;bbzb-lu/bbzb-tools, für alle sichtbar" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="190" width="260" height="100" as="geometry"/></mxCell><mxCell id="c11" value="git add" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="git commit" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="git push" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="git pull: Neues von GitHub holen" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c10" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="340"/><mxPoint x="170" y="340"/></Array></mxGeometry></mxCell><mxCell id="c15" value="In VS Code oder GitHub Desktop sind das Knöpfe: «Stage», «Commit», «Push»." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1600" y="190" width="180" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;2&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="34" height="34" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Branches: parallel arbeiten, ohne main zu stören&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="403" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="442" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;main&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="110" height="36" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;branch&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="110" height="36" as="geometry"/></mxCell><mxCell id="c21" value="A" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="480" width="36" height="36" as="geometry"/></mxCell><mxCell id="c22" value="B" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="480" width="36" height="36" as="geometry"/></mxCell><mxCell id="c23" value="C" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="480" width="36" height="36" as="geometry"/></mxCell><mxCell id="c24" value="M" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="36" height="36" as="geometry"/></mxCell><mxCell id="c25" value="1" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="600" width="36" height="36" as="geometry"/></mxCell><mxCell id="c26" value="2" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="600" width="36" height="36" as="geometry"/></mxCell><mxCell id="c27" value="3" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;ellipse;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="600" width="36" height="36" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=4;strokeColor=#d79b00;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=4;strokeColor=#d79b00;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=4;strokeColor=#d79b00;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=4;strokeColor=#6c8ebf;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;endArrow=none;strokeWidth=4;strokeColor=#6c8ebf;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=none;strokeColor=#6c8ebf;exitX=1;exitY=1;entryX=0;entryY=0;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=none;strokeColor=#d79b00;exitX=1;exitY=0;entryX=0;entryY=1;" edge="1" parent="1" source="c27" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="① abzweigen:&lt;br&gt;&lt;i&gt;git switch -c mein-thema&lt;/i&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="260" height="40" as="geometry"/></mxCell><mxCell id="c36" value="② Pull Request, dann Merge" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="300" height="40" as="geometry"/></mxCell><mxCell id="c37" value="• &lt;b&gt;main&lt;/b&gt; läuft immer, daraus entsteht die Live-Seite.&lt;br&gt;• Jede Änderung bekommt ihren eigenen &lt;b&gt;Branch&lt;/b&gt;.&lt;br&gt;• Commits 1 bis 3 liegen nur im Branch, main merkt nichts.&lt;br&gt;• Commit C kam inzwischen von jemand anderem.&lt;br&gt;• Erst der &lt;b&gt;Merge&lt;/b&gt; (M) bringt alles nach main und damit live." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1100" y="470" width="660" height="200" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;3&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="34" height="34" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Begriffe&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="723" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c40" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="762" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Commit&lt;/b&gt;&lt;br&gt;Gespeicherter Stand mit Nachricht und ID (z. B. 845798a). Klein halten, Nachricht auf Englisch." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="410" height="112" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Versionierung&lt;/b&gt;&lt;br&gt;Jeder Commit bleibt erhalten. Fehler macht man mit einem neuen Commit rückgängig (git revert)." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="472" y="780" width="410" height="112" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Branch&lt;/b&gt;&lt;br&gt;Eigene Linie von Commits. Der Name sagt das Thema, z. B. «radio-stream»." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="904" y="780" width="410" height="112" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Push / Pull&lt;/b&gt;&lt;br&gt;Push lädt deine Commits auf GitHub, Pull holt die der anderen." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1336" y="780" width="410" height="112" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Pull Request (PR)&lt;/b&gt;&lt;br&gt;«Bitte diesen Branch in main übernehmen.» Hier laufen Tests und die Vorschau." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="410" height="112" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Merge&lt;/b&gt;&lt;br&gt;Übernimmt den Branch in main. Danach geht es automatisch live." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="472" y="910" width="410" height="112" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;CI&lt;/b&gt;&lt;br&gt;GitHub Actions: prüft, baut und veröffentlicht bei jedem Push." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="904" y="910" width="410" height="112" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Issue&lt;/b&gt;&lt;br&gt;Wunsch oder Fehler auf GitHub, mit Label pro Tool, sichtbar auf dem Board." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1336" y="910" width="410" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 Mitarbeiten"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="90" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;So arbeitest du mit&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=26;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1720" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Einmal Zugang einrichten, dann über Issues, Branches und Pull Requests mitarbeiten." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=15;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1720" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="34" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Zugang einrichten (einmalig)&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="86" y="123" width="1670" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=0;strokeColor=none;fillColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="40" y="162" width="1720" height="2" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Wo:&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;text;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="124" width="120" height="24" as="geometry"/></mxCell><mxCell id="c8" value="dein Rechner" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c9" value="GitHub" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c10" value="GitHub Actions" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c11" value="Cloudflare" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c12" value="Absprache" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=30;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1620" y="124" width="140" height="26" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;1 GitHub-Konto&lt;/b&gt;&lt;br&gt;privat erstellen, Zwei-Faktor einschalten" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;2 Benutzername melden&lt;/b&gt;&lt;br&gt;an die verantwortliche Person" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="332" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;3 Collaborator&lt;/b&gt;&lt;br&gt;BBZB-Konto: Repo → Settings → Collaborators → Add people" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="624" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;4 Einladung annehmen&lt;/b&gt;&lt;br&gt;Mail von GitHub oder github.com/notifications" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="916" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;5 Board freigeben&lt;/b&gt;&lt;br&gt;BBZB-Konto: Projekt → Settings → Manage access" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#eeeeee;strokeColor=#666666;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1208" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;6 Rechner einrichten&lt;/b&gt;&lt;br&gt;siehe Blatt «Entwicklung mit KI»" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="190" width="250" height="100" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="html=1;fontFamily=Segoe UI;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#555555;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;Was ein Collaborator darf&lt;/b&gt;&lt;br&gt;• Issues, Branches und Pull Requests erstellen, mergen&lt;br&gt;• &lt;b&gt;nicht&lt;/b&gt;: Einstellungen, Secrets, Zugänge ändern (nur BBZB-Konto)" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="840" height="110" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Lizenzierte Inhalte&lt;/b&gt; (z. B. Schriften)&lt;br&gt;liegen in einem privaten Repo. Wer sie lokal braucht, wird dort zusätzlich eingeladen und holt sie mit &lt;i&gt;npm run fonts&lt;/i&gt;. Ohne Zugang läuft alles, nur ohne diese Inhalte." style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=12;spacingRight=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="920" y="320" width="840" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;2&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fillColor=#ffffff;strokeColor=#999999;ellipse;fontSize=15;fillColor=#333333;fontColor=#ffffff;stro